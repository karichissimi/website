# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# claude code
.claude/*
!.claude/settings.json

# local AI tooling configs (skills, agents, etc.) — keep out of repo
.adal/
.agents/
.augment/
.bob/
.codebuddy/
.commandcode/
.continue/
.cortex/
.crush/
.factory/
.goose/
.iflow/
.junie/
.kilocode/
.kiro/
.kode/
.mcpjam/
.mux/
.neovate/
.openhands/
.pi/
.pochi/
.qoder/
.qwen/
.roo/
.trae/
.vibe/
.windsurf/
.zencoder/
skills/
skills-lock.json

# internal project materials (CVs, business plan, investor deck, strategy docs) — never commit
/AAA-Doc/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# La configurazione del metodo di lavoro va versionata: serve anche alle sessioni cloud,
# che partono da una macchina pulita e non trovano nulla di locale.
!.claude/settings.json
